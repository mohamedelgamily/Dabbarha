# Local development SQLite database. Production will later use PostgreSQL.
DATABASE_URL=sqlite:///./dabbarha.db

# Authentication settings. Leave JWT_SECRET_KEY empty here and set a real secret locally or in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API key for the chatbot. Leave empty here and set a real key locally or in production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Application secrets will be added here in later phases.
