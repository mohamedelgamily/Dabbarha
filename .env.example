# Explicitly select development, test or production. Unset APP_ENV means production.
# Load this configuration explicitly: uvicorn app.main:app --env-file /absolute/path/to/.env.local
APP_ENV=development

# Existing SQLite behavior is retained; production database policy is a later batch.
DATABASE_URL=sqlite:///./dabbarha.db

# REQUIRED in every environment. Empty here intentionally: supply a securely generated
# secret of at least 32 UTF-8 bytes locally or through deployment secret management.
# Never reuse a sample/placeholder, print the real value, or rotate an existing key silently.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Defaults: docs enabled in development/test, disabled in production.
# Remove this explicit override when preparing production configuration.
API_DOCS_ENABLED=true

# Development/test only: local counters are bounded but are NOT shared across workers.
# Production requires redis, a private RATE_LIMIT_REDIS_URL and a separate HMAC key.
# See docs/api-security.md and .env.production.example. Do not copy memory into production.
RATE_LIMIT_BACKEND=memory
