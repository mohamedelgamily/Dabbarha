# Explicitly select development, test or production. Unset APP_ENV means production.
# Load this configuration explicitly: uvicorn app.main:app --env-file /absolute/path/to/.env.local
APP_ENV=development

# Existing SQLite behavior is retained; production database policy is a later batch.
DATABASE_URL=sqlite:///./dabbarha.db

# REQUIRED in every environment. Empty here intentionally: supply a securely generated
# secret of at least 32 UTF-8 bytes locally or through deployment secret management.
# Never reuse a sample/placeholder, print the real value, or rotate an existing key silently.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Defaults: docs enabled in development/test, disabled in production.
# Remove this explicit override when preparing production configuration.
API_DOCS_ENABLED=true

# Development/test only: local counters are bounded but are NOT shared across workers.
# Production requires redis, a private RATE_LIMIT_REDIS_URL and a separate HMAC key.
# See docs/api-security.md and .env.production.example. Do not copy memory into production.
RATE_LIMIT_BACKEND=memory
# Managed private DNS endpoints require rediss://, certificate verification and
# a narrow RFC1918/IPv6 ULA CIDR allowlist; see docs/api-security.md.
RATE_LIMIT_REDIS_ALLOWED_CIDRS=

# Phase 2b.6: enable only after approved migration and worker/mobile rollout.
SESSION_AUTH_ENABLED=false
# Required when enabled: separate random 32-byte key, standard base64 encoded.
# No fallback, no JWT/limiter key reuse. Keep actual values out of logs/Git.
SESSION_RECEIPT_KEY=
SESSION_RECEIPT_KEY_ID=v1
SESSION_ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_REFRESH_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
SESSION_REFRESH_LIMIT=10
SESSION_REFRESH_IP_LIMIT=60
SESSION_DB_LOCK_TIMEOUT_SECONDS=5
SESSION_LEGACY_ISSUANCE=true
SESSION_LEGACY_ACCEPTANCE=true

# Payment reminders remain off until the mobile client completes device-session
# login, push permission and Expo token registration integration.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_PROVIDER=mock
PUSH_TOKEN_ENCRYPTION_KEY=
PUSH_TOKEN_ENCRYPTION_KEY_ID=v1
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RECEIPT_MAX_ATTEMPTS=8
NOTIFICATION_RECEIPT_AFTER_SECONDS=900
NOTIFICATION_RECEIPT_RETENTION_SECONDS=86400
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_STALE_SEND_SECONDS=300
# Fixed approved recovery: 60 seconds, two retries; see docs/auth-sessions.md.
