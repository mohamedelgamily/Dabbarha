# PLACEHOLDER TEMPLATE ONLY. Configure through trusted deployment secret management.
# This template intentionally fails startup until real secrets are supplied privately.
APP_ENV=production
API_DOCS_ENABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=unix:///run/dabbarha/limiter.sock
RATE_LIMIT_HMAC_KEY=
# Supply the separately approved deployment DATABASE_URL; this phase does not migrate it.
# All rate/request knobs and defaults are documented in docs/api-security.md.

# Phase 2b.6: enable only after approved migration and worker/mobile rollout.
SESSION_AUTH_ENABLED=false
# Required when enabled: separate random 32-byte key, standard base64 encoded.
# No fallback, no JWT/limiter key reuse. Keep actual values out of logs/Git.
SESSION_RECEIPT_KEY=
SESSION_RECEIPT_KEY_ID=v1
SESSION_ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_REFRESH_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
SESSION_REFRESH_LIMIT=10
SESSION_REFRESH_IP_LIMIT=60
SESSION_DB_LOCK_TIMEOUT_SECONDS=5
SESSION_LEGACY_ISSUANCE=true
SESSION_LEGACY_ACCEPTANCE=true
# Fixed approved recovery: 60 seconds, two retries; see docs/auth-sessions.md.
