# PLACEHOLDER TEMPLATE ONLY. Configure through trusted deployment secret management.
# This template intentionally fails startup until real secrets are supplied privately.
APP_ENV=production
API_DOCS_ENABLED=false
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=unix:///run/dabbarha/limiter.sock
RATE_LIMIT_HMAC_KEY=
# Supply the separately approved deployment DATABASE_URL; this phase does not migrate it.
# All rate/request knobs and defaults are documented in docs/api-security.md.
