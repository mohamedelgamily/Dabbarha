# Inactive template for /etc/dabbarha/worker.env; keep root-owned and mode 0600.
# This process reads only runtime/database and notification settings. It does not
# require or receive JWT, rate-limit, admin-TOTP, or refresh-receipt keys.
APP_ENV=production
DATABASE_URL=

# Remain disabled until the mobile/session rollout, database role, and push setup
# have been reviewed in staging. When enabled, session auth and the push-token
# encryption key are required. The API and worker may share only this data key.
SESSION_AUTH_ENABLED=false
NOTIFICATIONS_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_PROVIDER=expo
PUSH_TOKEN_ENCRYPTION_KEY=
PUSH_TOKEN_ENCRYPTION_KEY_ID=v1
EXPO_PUSH_ACCESS_TOKEN=
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RECEIPT_MAX_ATTEMPTS=8
NOTIFICATION_RECEIPT_AFTER_SECONDS=900
NOTIFICATION_RECEIPT_RETENTION_SECONDS=86400
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_STALE_SEND_SECONDS=300
